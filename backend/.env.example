# MRP Backend Environment Variables - Local Development
# Copy to .env and adjust values. Never commit .env.

# Database
MRP_DB_URL=jdbc:mysql://localhost:3306/mrp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
MRP_DB_USERNAME=mrp
MRP_DB_PASSWORD=

# Redis
MRP_REDIS_HOST=localhost
MRP_REDIS_PORT=6379
MRP_REDIS_PASSWORD=

# Server
MRP_SERVER_PORT=8080

# JWT (set a unique secret of at least 32 bytes)
MRP_JWT_SECRET=
MRP_JWT_EXPIRATION=3600

# File Upload
MRP_FILE_UPLOAD_DIR=./data/uploads

# Spring Profiles
SPRING_PROFILES_ACTIVE=local

# Feishu Login (set real values in .env, never commit)
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_REDIRECT_URI=http://localhost:5180/login/callback/
